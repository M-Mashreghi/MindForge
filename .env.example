# Optional AI proxy (backend/). Copy to .env or export in your shell.
# Never commit real values. The game client never sees these.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# "anthropic" when LLM_API_KEY is set, otherwise "mock" (offline).
MINDFORGE_PROVIDER=
MINDFORGE_PROXY_HOST=127.0.0.1
MINDFORGE_PROXY_PORT=8787
MINDFORGE_PROVIDER_TIMEOUT=20
