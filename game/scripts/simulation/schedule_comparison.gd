extends RefCounted
## Adaptive-vs-static difficulty experiment (Task 7.8). Every archetype and
## seed is played twice, once with the game's adaptive scheduler and once
## with a fixed difficulty ramp, by the same latent player (same seed).
##
## Measures (per schedule, averaged over seeds):
##   true_fit       rooms whose true success is 0.55..0.90 (appropriate challenge)
##   too_hard       rooms whose true success is below 0.40 (frustration proxy)
##   too_easy       rooms whose true success is above 0.95 (boredom proxy)
##   abandon_rate, hint_rate, success_rate
##   progression    mean difficulty of the last third minus the first third
##   oscillation    mean |change| of target difficulty within a family
##   final_error    |estimate - latent| at the end (estimates update in both arms)
## Score is deliberately not a measure here.

const Harness := preload("res://game/scripts/simulation/simulation_harness.gd")
const LatentPlayer := preload("res://game/scripts/simulation/latent_player.gd")
const Metrics := preload("res://game/scripts/simulation/adaptive_metrics.gd")
const AdaptiveConfig := preload("res://game/scripts/adaptive/adaptive_config.gd")

const COMPARISON_VERSION := "schedule-comparison-v1"
const SCHEDULES := ["adaptive", "static"]
const MEASURES := ["true_fit", "too_hard", "too_easy", "abandon_rate", "hint_rate", "success_rate", "progression",
	"oscillation", "final_error"]
const POINT_MEASURES := ["progression", "oscillation", "final_error"]
const TOO_HARD := 0.40
const TOO_EASY := 0.95


static func compare(seeds: Array = [1, 2, 3], rooms: int = 36) -> Dictionary:
	var archetypes := {}
	for archetype in LatentPlayer.ARCHETYPES:
		var arms := {}
		for schedule in SCHEDULES:
			var per_seed: Array = []
			for seed_value in seeds:
				per_seed.append(measure(Harness.run(archetype, seed_value, rooms, schedule)["rows"]))
			arms[schedule] = _average(per_seed)
		archetypes[archetype] = arms
	return {
		"comparison_version": COMPARISON_VERSION,
		"harness_version": Harness.HARNESS_VERSION,
		"player_model": LatentPlayer.MODEL_VERSION,
		"metrics_version": Metrics.METRICS_VERSION,
		"adaptive_algorithm_version": AdaptiveConfig.ALGORITHM_VERSION,
		"seeds": seeds,
		"rooms": rooms,
		"static_ramp": [Harness.STATIC_START, Harness.STATIC_END],
		"archetypes": archetypes,
		"overall": _overall(archetypes),
	}


static func measure(rows: Array) -> Dictionary:
	var m: Dictionary = Metrics.compute(rows)["overall"]
	var scheduled := rows.filter(func(r): return r["band"] != "warmup")
	var third := maxi(1, rows.size() / 3)
	var first := rows.slice(0, third).map(func(r): return float(r["difficulty"]))
	var last := rows.slice(rows.size() - third).map(func(r): return float(r["difficulty"]))
	var errors: Array = []
	for family in ["pattern", "logic", "memory"]:
		var fam := rows.filter(func(r): return r["family"] == family)
		if not fam.is_empty():
			errors.append(absf(fam[-1]["estimate"] - fam[-1]["latent"]))
	return {
		"true_fit": m["true_fit"],
		"too_hard": _share(scheduled, func(r): return r["true_success"] < TOO_HARD),
		"too_easy": _share(scheduled, func(r): return r["true_success"] > TOO_EASY),
		"abandon_rate": _share(rows, func(r): return r["abandoned"]),
		"hint_rate": _share(rows, func(r): return r["hints_used"] > 0),
		"success_rate": m["success_rate"],
		"progression": _mean(last) - _mean(first),
		"oscillation": m["oscillation"],
		"final_error": _mean(errors),
	}


static func _overall(archetypes: Dictionary) -> Dictionary:
	var out := {}
	for schedule in SCHEDULES:
		out[schedule] = _average(archetypes.values().map(func(a): return a[schedule]))
	return out


static func _average(entries: Array) -> Dictionary:
	var out := {}
	for key in MEASURES:
		out[key] = snappedf(_mean(entries.map(func(e): return e[key])), 0.001)
	return out


static func _share(rows: Array, pred: Callable) -> float:
	if rows.is_empty():
		return 0.0
	return float(rows.filter(pred).size()) / rows.size()


static func _mean(values: Array) -> float:
	if values.is_empty():
		return 0.0
	var total := 0.0
	for v in values:
		total += float(v)
	return total / values.size()


## Markdown report (deterministic for the same inputs).
static func to_markdown(result: Dictionary) -> String:
	var lines: PackedStringArray = [
		"# Adaptive vs Static Difficulty",
		"",
		"Generated by `tools/compare_schedules.gd` (%s). Re-run it to reproduce this file exactly." % result["comparison_version"],
		"",
		"- Adaptive algorithm `%s`, harness `%s`, simulated player `%s`, metrics `%s`." % [
			result["adaptive_algorithm_version"], result["harness_version"], result["player_model"], result["metrics_version"]],
		"- Seeds %s, %d rooms per run. Both schedules face the same simulated player with the same seed." % [str(result["seeds"]), result["rooms"]],
		"- Static schedule: a fixed ramp from %d to %d with rotating families." % [result["static_ramp"][0], result["static_ramp"][1]],
		"- Challenge fit means true success between 0.55 and 0.90; too hard is below %.2f and too easy is above %.2f. These come from the simulated player, not from the game's own prediction." % [TOO_HARD, TOO_EASY],
		"- Progression is the mean difficulty of the last third of rooms minus the first third. Score is not used as a measure.",
		"",
		"## Overall (mean over archetypes)",
		"",
	]
	lines.append_array(_table(result["overall"]))
	for archetype in result["archetypes"]:
		lines.append("")
		lines.append("## %s" % str(archetype).capitalize())
		lines.append("")
		lines.append_array(_table(result["archetypes"][archetype]))
	lines.append("")
	return "\n".join(lines)


static func _table(arms: Dictionary) -> PackedStringArray:
	var rows: PackedStringArray = ["| Measure | Adaptive | Static |", "| --- | ---: | ---: |"]
	for key in MEASURES:
		var point: bool = key in POINT_MEASURES
		var fmt := "%.1f" if point else "%.0f%%"
		var scale := 1.0 if point else 100.0
		rows.append("| %s | %s | %s |" % [key.replace("_", " "), fmt % (arms["adaptive"][key] * scale), fmt % (arms["static"][key] * scale)])
	return rows
